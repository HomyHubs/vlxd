{
  "name": "vlxd-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "prettier": "@vlxd/config-prettier",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md,yaml,yml}\"",
    "generate:api-client": "pnpm --filter @vlxd/api-client generate",
    "check:drift": "node scripts/check-openapi-drift.mjs",
    "check": "pnpm run check:drift && turbo run lint typecheck test build && pnpm run format:check",
    "db:migrate": "dbmate --migrations-dir db/migrations up",
    "db:rollback": "dbmate --migrations-dir db/migrations rollback",
    "db:status": "dbmate --migrations-dir db/migrations status",
    "test:smoke": "node scripts/smoke-test.mjs",
    "staging:build": "docker compose -f compose.staging.yml build",
    "staging:up": "docker compose -f compose.staging.yml up -d",
    "staging:down": "docker compose -f compose.staging.yml down",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@vlxd/config-prettier": "workspace:*",
    "dbmate": "^2.35.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "globals": "^16.0.0",
    "openapi-typescript": "^7.6.1",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.25.0"
  }
}
