{
  "name": "@vlxd/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@vlxd/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@vlxd/config-eslint": "workspace:*",
    "@vlxd/config-ts": "workspace:*",
    "eslint": "^9.21.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  }
}
