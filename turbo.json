{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "lint:fix": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "check": {
      "dependsOn": ["build", "typecheck", "lint", "test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
