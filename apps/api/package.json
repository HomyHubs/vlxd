{
  "name": "@vlxd/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@vlxd/shared": "workspace:*",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^7.0.0",
    "kysely": "^0.27.5",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/pg": "^8.11.11",
    "@vlxd/config-eslint": "workspace:*",
    "@vlxd/config-ts": "workspace:*",
    "eslint": "^9.21.0",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  }
}
