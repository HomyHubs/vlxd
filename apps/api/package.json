    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.8",
    "@types/pg": "^8.11.11",
    "@vlxd/config-eslint": "workspace:*",
    "@vlxd/config-ts": "workspace:*",
    "eslint": "^9.21.0",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
